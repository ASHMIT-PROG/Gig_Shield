rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Trigger events — readable by authenticated users, writable only by Cloud Functions (admin SDK)
    match /triggerEvents/{city}/events/{eventType} {
      allow read: if request.auth != null;
      allow write: if false; // Only Cloud Functions (admin SDK) can write
    }

    // Default: deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
